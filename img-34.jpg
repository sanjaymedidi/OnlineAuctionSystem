<%@page import="java.io.PrintWriter"%>
<%@page import="java.sql.PreparedStatement"%>
<%@page import="com.database.databasecom"%>
<%@page import="java.sql.Connection"%>
<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
    pageEncoding="ISO-8859-1"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1">
<title>Insert title here</title>
</head>
<body>
<%
  HttpSession httpSession=  request.getSession();
  String mobile=(String)  httpSession.getAttribute("smobile");
    
    String pbrand=request.getParameter("brand");
    String pcolor=request.getParameter("color");
    String pcategory=request.getParameter("category");
    String pcondition=request.getParameter("condition");
    String pwarranty=request.getParameter("warranty");
    String pyop=request.getParameter("manufactureYear");
    String pdescription=request.getParameter("description");
    
    
	try{
		Connection conn=databasecom.getConnection();
		PreparedStatement pst=conn.prepareStatement("insert into product values(?,?,?,?,?,?,?,?)");
		pst.setString(1, pbrand);
		pst.setString(2, pcolor);
		pst.setString(3, pcategory);
		pst.setString(4, pcondition);
		pst.setString(5, pwarranty);
		pst.setString(6, pyop);
		pst.setString(7, pdescription);
		pst.setString(8,mobile );
		int i=pst.executeUpdate();
		if(i==1){
			
			response.sendRedirect("SellerDashBoard.html");
			
		}else{
			response.sendRedirect("addProductForm.jsp");

		}
	}catch(Exception e){
		e.printStackTrace();
		
	}
%>

</body>
</html>